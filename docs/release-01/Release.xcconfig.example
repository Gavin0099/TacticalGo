// Copy to a reviewed local Release.xcconfig after real account setup.
// This example is intentionally NOT usable: public IDs/URLs/signing fields are empty.
// 1.0 is for the final release candidate; do not relabel the current 0.10.11 build.
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1024
// Preserve the Owner's existing iPhone/iPad app identity (1022 -> 1023 same-bundle updates).
// com.tacticalgo.prototype is the Simulator/unsigned-build default, not an approved final identity.
// Match this bundle with the ASC app/product, AdMob app and App Store distribution profile.
// Existing development installs do not prove those account records are ready.
PRODUCT_BUNDLE_IDENTIFIER = com.tacticalgo.prototype.herobody

// Confirm the actual enrolled distribution team; known engineering reference P358EB3X9H is not account readiness.
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Apple Distribution
PROVISIONING_PROFILE_SPECIFIER =

// Real non-consumable ID from this game's App Store Connect record.
CROWN_UNLOCK_PRODUCT_ID =
// Real AdMob App ID and rewarded unit. Never copy Google sample publisher 3940256099942544.
CROWN_ADMOB_APP_ID =
CROWN_REWARDED_AD_UNIT_ID =

// xcconfig treats // as a comment. For HTTPS values use https:/$()/your-host/path
// The empty $() expansion restores the second slash at build time.
// A literal https://... here can become only https: and must fail preflight.
CROWN_PRIVACY_URL =
CROWN_SUPPORT_URL =
